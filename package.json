{
  "name": "oh-my-dsh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Curated and machine-readable plugin directory for DeepSeek Harness",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "update": "node --import tsx scripts/update-registry.ts",
    "validate": "node --import tsx scripts/validate-registry.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run test && npm run typecheck && npm run validate"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
