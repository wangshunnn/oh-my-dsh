{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wangshunnn/oh-my-dsh/registry/schema.json",
  "title": "oh-my-dsh registry",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "source", "stats", "plugins"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": [
        "provider", "query", "url", "mode", "scannedAt", "lastFullScanAt",
        "windowStart", "windowEnd", "reportedTotal", "discoveredTotal", "slices", "graphqlRequests"
      ],
      "properties": {
        "provider": { "const": "github" },
        "query": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "mode": { "enum": ["full", "incremental"] },
        "scannedAt": { "type": "string", "format": "date-time" },
        "lastFullScanAt": { "type": "string", "format": "date-time" },
        "windowStart": { "type": "string", "format": "date-time" },
        "windowEnd": { "type": "string", "format": "date-time" },
        "reportedTotal": { "type": "integer", "minimum": 0 },
        "discoveredTotal": { "type": "integer", "minimum": 0 },
        "slices": { "type": "integer", "minimum": 0 },
        "graphqlRequests": { "type": "integer", "minimum": 0, "maximum": 700 }
      },
      "additionalProperties": false
    },
    "stats": {
      "type": "object",
      "required": ["included", "byKind", "byEvidence"],
      "properties": {
        "included": { "type": "integer", "minimum": 0 },
        "byKind": { "$ref": "#/$defs/countMap" },
        "byEvidence": { "$ref": "#/$defs/countMap" }
      },
      "additionalProperties": false
    },
    "plugins": {
      "type": "array",
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "countMap": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "plugin": {
      "type": "object",
      "required": [
        "id", "githubNodeId", "name", "owner", "repository", "url", "description",
        "kind", "categories", "topics", "language", "license", "metrics",
        "repositoryState", "package", "evidence"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "githubNodeId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "description": { "type": ["string", "null"] },
        "kind": {
          "enum": ["plugin", "bundle", "skin", "client", "application", "collection", "resource", "unknown"]
        },
        "categories": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "topics": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "language": { "type": ["string", "null"] },
        "license": {
          "type": "object",
          "required": ["spdx", "status"],
          "properties": {
            "spdx": { "type": ["string", "null"] },
            "status": { "enum": ["detected", "unknown"] }
          },
          "additionalProperties": false
        },
        "metrics": {
          "type": "object",
          "required": ["stars", "forks", "openIssues"],
          "properties": {
            "stars": { "type": "integer", "minimum": 0 },
            "forks": { "type": "integer", "minimum": 0 },
            "openIssues": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "repositoryState": {
          "type": "object",
          "required": ["defaultBranch", "headOid", "createdAt", "pushedAt", "updatedAt"],
          "properties": {
            "defaultBranch": { "type": "string" },
            "headOid": { "type": ["string", "null"] },
            "createdAt": { "type": "string", "format": "date-time" },
            "pushedAt": { "type": ["string", "null"], "format": "date-time" },
            "updatedAt": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        },
        "package": {
          "type": "object",
          "required": ["name", "version", "private", "manifest"],
          "properties": {
            "name": { "type": ["string", "null"] },
            "version": { "type": ["string", "null"] },
            "private": { "type": ["boolean", "null"] },
            "manifest": { "enum": ["dsh.bundle", "dshx", "dsh-structure", null] }
          },
          "additionalProperties": false
        },
        "evidence": {
          "type": "object",
          "required": ["status", "checkedAt"],
          "properties": {
            "status": { "enum": ["bundle-manifest", "legacy-manifest", "dsh-structure", "topic-only"] },
            "checkedAt": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
